010,4,Ladedruck (Ist),0.005*A*B,bar,0.5,1.8

C00,Codierung Motorsteuergerät
C01,00001 = Frontantrieb, Schaltgetriebe
C02,00002 = Allradantrieb (quattro)
C03,00003 = Frontantrieb, Automatikgetriebe
C04,00004 = Allradantrieb, Automatikgetriebe
